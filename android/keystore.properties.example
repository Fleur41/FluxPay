# Copy to keystore.properties (git-ignored) to sign release builds for Google Play.
# Generate a key with:
#   keytool -genkeypair -v -keystore fluxpay-release.jks -alias fluxpay -keyalg RSA -keysize 4096 -validity 10000
storeFile=../fluxpay-release.jks
storePassword=change-me
keyAlias=fluxpay
keyPassword=change-me
