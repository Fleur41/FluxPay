<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; this theme only sets window defaults. -->
    <style name="Theme.FluxPay" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/flux_mist</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Android 12+ style splash screen (backported by androidx.core:core-splashscreen). -->
    <style name="Theme.FluxPay.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/flux_violet</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.FluxPay</item>
    </style>
</resources>
