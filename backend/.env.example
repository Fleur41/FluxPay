# Copy to .env and adjust. Never commit the real .env.
# Business rules (currencies, limits, signup bonus, timeouts) are not set here: staff edit them in
# Django admin under "Platform settings", and the app reads them from /api/v1/config/.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-string-at-least-50-chars
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
DATABASE_URL=postgres://fluxpay:fluxpay@localhost:5432/fluxpay

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

PASSWORD_RESET_LINK=fluxpay://reset-password?uid={uid}&token={token}
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMS alerts: printed to the log until an Africa's Talking API key is set.
# AFRICASTALKING_USERNAME=sandbox
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_SENDER_ID=

# Background payment jobs. Unset = jobs run inline in the web process (no Redis needed, no scheduled jobs).
# docker compose sets this for you.
# CELERY_BROKER_URL=redis://localhost:6379/0
# Secret segment of provider callback URLs: https://<host>/hooks/<rail>/<token>/
FLUXPAY_WEBHOOK_TOKEN=replace-with-a-long-random-string
# Public https URL of this API; M-Pesa sends its callbacks here (in development, an ngrok-style tunnel).
# FLUXPAY_PUBLIC_URL=https://api.example.com

# M-Pesa (Safaricom Daraja). Deposits (STK Push) are on once the key, secret, passkey and public URL are set.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Payouts (B2C to phones, B2B to paybills and tills). The security credential is the initiator password
# encrypted with Safaricom's certificate, as the Daraja portal generates it.
# MPESA_PAYOUT_SHORTCODE=600000
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
# A payout with no result after this many hours is flagged for staff to check in the admin.
# FLUXPAY_PAYOUT_REVIEW_AFTER_HOURS=24

# Bank payouts are sent by FluxPay staff from the bank and confirmed in the admin. On by default when DEBUG is on;
# only switch it on in production when someone works the queue (admin > External payments > Bank payouts to send).
# FLUXPAY_BANK_PAYOUTS=true
